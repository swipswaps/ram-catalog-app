FROM python:3.10-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 libsm6 libxext6 libxrender1 curl build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Install Paddle first to cache the heavy layer (~500MB wheel)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir paddlepaddle==2.6.1 && \
    pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
RUN mkdir -p /app/static/cad

ENV DB_PATH=/app/ram_catalog.db
ENV CORS_ORIGINS=https://swipswaps.github.io,http://localhost:5173
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
